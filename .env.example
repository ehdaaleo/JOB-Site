# Laravel API base URL (the SPA only talks to this).
VITE_API_URL=http://127.0.0.1:8000/api

# PayPal sandbox client id used by CheckoutView (matches the
# PAYPAL_CLIENT_ID configured on the Laravel side).
VITE_PAYPAL_CLIENT_ID=test

# Optional Groq key for the AI helpers in src/composables/useAI.js.
# Leave empty to disable AI generation; UI still works.
VITE_GROQ_API_KEY=

PORT=5173
