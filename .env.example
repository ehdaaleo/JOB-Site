# API base URL (your Laravel backend, when ready)
VITE_API_URL=http://localhost:8000/api

# Groq AI - for cover letter generation (optional)
VITE_GROQ_API_KEY=your_groq_api_key_here

# PayPal Sandbox - REQUIRED for payment feature
# 1. Go to https://developer.paypal.com/dashboard/applications/sandbox
# 2. Create a new app (or use the default sandbox app)
# 3. Copy the Client ID and paste it below
VITE_PAYPAL_CLIENT_ID=your_sandbox_client_id_here
